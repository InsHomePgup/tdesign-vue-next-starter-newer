{
  "name": "@tencent/tdesign-vue-next-starter",
  "version": "0.13.1",
  "type": "module",
  "scripts": {
    "dev:mock": "vite --open --mode mock",
    "dev": "vite --open --mode development",
    "dev:linux": "vite --mode development",
    "build:test": "vite build --mode test",
    "build": "vue-tsc --noEmit && vite build --mode release",
    "build:type": "vue-tsc --noEmit",
    "build:site": "vue-tsc --noEmit && vite build --mode site",
    "preview": "vite preview",
    "lint": "eslint --ext .vue,.js,.jsx,.ts,.tsx ./ --max-warnings 0",
    "lint:fix": "eslint --ext .vue,.js,jsx,.ts,.tsx ./ --max-warnings 0 --fix",
    "prepare": "husky",
    "site:preview": "npm run build && cp -r dist _site",
    "test": "echo \"no test specified,work in process\"",
    "test:coverage": "echo \"no test:coverage specified,work in process\""
  },
  "dependencies": {
    "@vueuse/core": "^14.1.0",
    "axios": "^1.12.2",
    "dayjs": "^1.11.13",
    "echarts": "^6.0.0",
    "lodash": "^4.17.21",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qs": "^6.13.1",
    "tdesign-icons-vue-next": "^0.4.1",
    "tdesign-vue-next": "^1.15.2",
    "tvision-color": "^1.6.0",
    "vue": "^3.5.27",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.1.0",
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@types/lodash": "^4.17.6",
    "@types/mockjs": "^1.0.10",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.9.17",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitejs/plugin-vue-jsx": "^5.1.3",
    "@vue/compiler-sfc": "~3.5.27",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.22.0",
    "husky": "^9.1.7",
    "less": "^4.2.0",
    "lint-staged": "^16.2.7",
    "mockjs": "^1.1.0",
    "postcss-html": "^1.8.1",
    "postcss-less": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-mock": "^3.0.1",
    "vite-svg-loader": "^5.1.0",
    "vue-tsc": "^3.2.2"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "npm run lint:fix"
    ]
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
